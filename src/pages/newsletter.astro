---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('newsletter')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout>
	<main class="flex-1 px-4 py-12 md:py-16">
		<section class="max-w-3xl mx-auto text-center flex flex-col items-center gap-2">
			<h1 class="text-4xl md:text-5xl font-bold uppercase text-[var(--color-brand-green)] font-[family-name:var(--font-display)]">
				Newsletter
			</h1>
			<p class="text-gray-600">Agosto 2026</p>
		</section>

		<div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
			{posts.map((post) => (
				<article class="noticia-card rounded-xl border border-[var(--color-brand-green)]/40 overflow-hidden flex flex-col">
					<div class="aspect-video bg-[repeating-conic-gradient(#e5e7eb_0_25%,white_0_50%)] bg-[length:16px_16px]">
						{post.data.image && (
							<img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" />
						)}
					</div>
					<div class="p-4 flex flex-col gap-1 flex-1">
						<div class="flex items-center justify-between">
							<span class="text-xs font-bold text-[var(--color-brand-green)] uppercase">
								{post.data.type}
							</span>
							<time datetime={post.data.date.toISOString()} class="text-xs text-gray-400">
								{post.data.date.toLocaleDateString('es-PE', { day: 'numeric', month: 'short', year: 'numeric' })}
							</time>
						</div>
						<h3 class="font-bold text-[var(--color-brand-dark)]">
							{post.data.title}
						</h3>
						<p class="text-sm text-gray-600 flex-1">
							{post.data.description}
						</p>
						<a href={`/newsletter/${post.id}`} class="text-sm font-semibold text-[var(--color-brand-green)] self-end mt-2 hover:underline">
							ver más →
						</a>
					</div>
				</article>
			))}
		</div>

		<div class="flex justify-center mt-10">
			<button id="ver-mas" class="bg-[var(--color-brand-yellow)] text-black font-semibold px-6 py-2 rounded-full hover:brightness-95 transition-all">
				Ver más publicaciones
			</button>
		</div>
	</main>
</Layout>