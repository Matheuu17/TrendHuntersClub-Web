---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
// import { getCollection } from 'astro:content';
import mascotaConstruccion from '../assets/michiTra.png';

// const posts = (await getCollection('newsletter')).sort(
//     (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
// );
---

<Layout>
  <main class="min-h-[75vh] flex-1 flex flex-col items-center justify-center px-4 py-8 md:py-12 w-full overflow-x-hidden">
    <!-- Contenedor central integrado -->
    <div class="max-w-lg w-full flex flex-col items-center text-center">
      
      <!-- Título principal -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-[var(--color-brand-green,#006837)] font-[family-name:var(--font-display)]">
        Newsletter
      </h1>

      <!-- Ilustración sin marcos, integrada al fondo -->
      <div class="relative my-6 flex justify-center items-center w-full">
        <!-- Efecto sutil de aura/resplandor detrás -->
        <div class="absolute inset-0 bg-green-100/50 rounded-full blur-2xl -z-10 scale-90"></div>
        
        <Image 
          src={mascotaConstruccion} 
          alt="Sección en construcción" 
          class="w-auto h-56 sm:h-64 md:h-80 max-w-full object-contain drop-shadow-md bg-transparent"
          loading="eager"
        />
      </div>

      <!-- Mensaje de estado -->
      <div class="flex flex-col items-center gap-2 px-2">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 leading-tight">
          Estamos preparando las noticias
        </h2>
        
        <p class="text-sm sm:text-base text-gray-600 max-w-sm">
          Muy pronto publicaremos las novedades y artículos del mes aquí.
        </p>
      </div>

      <!-- Botón de retorno -->
      <div class="mt-6">
        <a 
          href="/" 
          class="inline-block bg-[var(--color-brand-yellow,#e6f000)] text-black font-semibold text-sm sm:text-base px-6 py-2.5 rounded-full hover:scale-105 hover:brightness-95 transition-all shadow-sm"
        >
          Volver al Inicio
        </a>
      </div>

    </div>
  </main>

