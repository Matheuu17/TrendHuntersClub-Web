---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/montserrat';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Trend Hunters Club | Comunidad de Marketing e Innovación</title>
    	<meta name="description" content="Espacio donde ideas, datos, creatividad y comunicación trabajan juntas para entender personas, mercados y tendencias." />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800;900&family=Fredoka:wght@600;700&display=swap" rel="stylesheet">
		<ClientRouter />
	</head>
	<body class="min-h-screen flex flex-col">
		<Header/>
		<div class="flex-1 flex flex-col">
			<slot />
		</div>
		<Footer/>
	</body>
</html>

<style>
	html{
		margin: 0;
		padding: 0;
	}

	body {
		margin: 0;
		padding: 0;
	}

	body > div {
		@apply container mx-auto
	}
</style>