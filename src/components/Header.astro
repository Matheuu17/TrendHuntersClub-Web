---
import Logo from '../components/Logo.astro';
---
<header class="w-full flex items-center justify-between py-5 px-6 md:px-12 lg:px-16">
  <!-- Navegación: pegada a la izquierda -->
  <nav class="text-[var(--color-brand-green,#006837)] flex flex-row items-center gap-x-4 sm:gap-x-6 md:gap-x-10 text-xs sm:text-sm md:text-lg font-bold uppercase">
    <a href="/" class="hover:text-[var(--color-brand-greenc)] hover:scale-105 transition-all duration-200">
      Inicio
    </a>
    <a href="/nosotros" class="hover:text-[var(--color-brand-greenc)] hover:scale-105 transition-all duration-200">
      Nosotros
    </a>
    <a href="/newsletter" class="hover:text-[var(--color-brand-greenc)] hover:scale-105 transition-all duration-200">
      Newsletter
    </a>

	 <!--
		<a href="/informes" class="hover:text-[var(--color-brand-greenc)] hover:scale-110 transition-all duration-200">
			Informes
		</a>
		-->

  </nav>

  <!-- Logo: pegado a la derecha -->
  <a href="/" aria-label="Trend Hunters Club - Inicio" class="shrink-0 flex items-center">
    <Logo class="w-14 sm:w-16 md:w-20 h-auto text-[#006A2C] hover:scale-105 transition-transform duration-300" />
  </a>
</header>